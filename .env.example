# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# Error Logging Channel (ID канала куда отправлять ошибки)
ERROR_LOG_CHANNEL_ID=-1003981422645

# Backup Channel (ID канала куда отправлять резервные копии БД)
# Бэкапы будут отправляться автоматически каждые 6 часов
BACKUP_CHANNEL_ID=-1004318502148

# Database Configuration
DB_PATH=math_tutor.db

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Application Settings
DEBUG=False
